<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
  <link rel="stylesheet" href="/public/splatoon.css">
</head>
<body>
  <%- include('sp_menu') %>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>ブキ名</td><td><%= data.name %></td></tr>
    <tr><td>武器種</td><td><%= data.type %></td></tr>
    <tr><td>サブウェポン</td><td><%= data.sub %></td></tr>
    <tr><td>スペシャルウェポン</td><td><%= data.special %></td></tr>
  </table>
  <a href="/weapon/edit/<%= id %>">編集</a>
  <a href="/weapon/delete/<%= id %>" onclick="return confirm('<%= data.name %>を削除しますか？');">削除</a>
  <a href="/weapon">ブキ一覧に戻る</a>
</body>
</html>
