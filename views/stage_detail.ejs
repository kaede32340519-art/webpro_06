<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
  <link rel="stylesheet" href="/public/splatoon.css">
</head>
<body>
  <%- include('sp_menu') %>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>ステージ名</td><td><%= data.name %></td></tr>
    <tr><td>初登場作品</td><td><%= data.origin %></td></tr>
    <tr><td>スプラトゥーン3への追加時期</td><td><%= data.added %></td></tr>
    <tr><td>特徴</td><td><%= data.feature %></td></tr>
  </table>
  <a href="/stage/edit/<%= id %>">編集</a>
  <a href="/stage/delete/<%= id %>" onclick="return confirm('<%= data.name %>を削除しますか？');">削除</a>
  <a href="/stage">ステージ一覧に戻る</a>
</body>
</html>
